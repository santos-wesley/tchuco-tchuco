<?xml version="1.0"?>
<!-- Tchuco Tchuco: slide clicker for the Forerunner 955 / 955 Solar. -->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="d2c3380422f14c0f958466d314078c3d" type="watch-app"
                    name="@Strings.AppName" entry="TchucoApp"
                    launcherIcon="@Drawables.LauncherIcon"
                    minApiLevel="3.3.0">
        <iq:products>
            <!-- The "fr955" id covers the Forerunner 955 and the 955 Solar. -->
            <iq:product id="fr955"/>
        </iq:products>
        <iq:permissions>
            <!-- Required by Communications.makeWebRequest. -->
            <iq:uses-permission id="Communications"/>
        </iq:permissions>
        <iq:languages>
            <!-- The app's texts are in English. -->
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
