<?xml version="1.0"?>
<!-- Tchuco Tchuco: passador de slides para o Forerunner 955 / 955 Solar. -->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="d2c3380422f14c0f958466d314078c3d" type="watch-app"
                    name="@Strings.AppName" entry="TchucoApp"
                    launcherIcon="@Drawables.LauncherIcon"
                    minApiLevel="3.3.0">
        <iq:products>
            <!-- O id "fr955" vale para o Forerunner 955 e para o 955 Solar. -->
            <iq:product id="fr955"/>
        </iq:products>
        <iq:permissions>
            <!-- Necessária para o Communications.makeWebRequest. -->
            <iq:uses-permission id="Communications"/>
            <!-- Necessária para gravar a "atividade" que faz o relógio seguir
                 a regra de notificações "durante a atividade". -->
            <iq:uses-permission id="Fit"/>
        </iq:permissions>
        <iq:languages>
            <!-- Os textos do app estão em português. -->
            <iq:language>por</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
