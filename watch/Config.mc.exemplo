// Configuração do Tchuco Tchuco: o ÚNICO lugar com a URL base e o tópico.
//
// Copie este arquivo para watch/source/Config.mc (que o git ignora) e troque
// o tópico por um nome longo e aleatório, igual ao usado no script do computador.
// O tópico funciona como senha: quem souber o nome consegue passar seus slides.
import Toybox.Lang;

module Config {
    // Servidor ntfy, sem barra no final.
    const URL_BASE as String = "https://ntfy.sh";
    // Tópico: só letras, números, "-" e "_", com até 64 caracteres.
    const TOPICO as String = "troque-por-um-topico-longo-e-aleatorio";
}
